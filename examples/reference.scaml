
fn add10 r {
  for (0..10000000) (^i -> r += i);
}

fn main () {
  let r = ref 0;
  incr r;
  #time add10 r;
  println (*r);

  let l = ref [];
  l = 1 :: *l;
  println (*l);

  // fold_right cost nothing with replacement of ocaml loop
  let b = 100;
  #time let _example_fold_left = fold_left (^acc e -> e::acc) [] (0..b);
  #time let _example_fold_right = fold_right (^e acc -> e::acc) (0..b) [];
  ()
}
