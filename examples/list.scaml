

fn main () {
    let l = [1; 2; 3];                  // define a list
    println l;                          // print that list

    println (1 + l);                    // add scalar 1 to the whole list
    println (2 * l);                    // multiply the whole list by 2
    println (l % 2);                    // modulo 2 over the whole array

    let l' = [4; 5; 6];

    println (l @ l');                   // concat

    let p = 2 * l + 1;
    let p' = 1 + l * 2;
    let p'' = map (^x -> 2 * x + 1) l;
    println (p == p' && p' == p'');     // true, the three var is doing the exact same things (because * prioritary)
}
