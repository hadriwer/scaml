type a btree {
    Leaf | Node of a btree, a, a btree
}

impl foldable of btree {
    fn fold_left f acc t {
        fn go acc t {
            match t {
                | Leaf -> acc
                | Node (l, v, r) -> go (f (go acc l) v) r
            }
        }
        go acc t
    }

    fn fold_right f t acc {
        fn go t acc {
            match t {
                | Leaf -> acc
                | Node (l, v, r) -> go l (f v (go r acc))
            }
        }
        go t acc
    }
}

impl iterable of btree {
    fn iter f t {
        fn go t {
            match t {
                | Leaf -> ()
                | Node (l, v, r) -> { go l; f v; go r }
            }
        }
        go t
    }
    fn iteri f t {
        // the index of the next node, in order
        fn go i t {
            match t {
                | Leaf -> i
                | Node (l, v, r) -> { let j = go i l; f j v; go (j + 1) r }
            }
        }
        let _ = go 0 t;
        ()
    }
}

// left subtree, right subtree, node
fn postfix_order bt {
  fn go t acc {
    match t {
      | Leaf -> acc
      | Node (l, x, r) -> go l (go r (x :: acc))
    }
  }
  go bt []
}

// node, left subtree, right subtree
fn prefix_order bt {
  fn go t acc {
    match t {
      | Leaf -> acc
      | Node (l, x, r) -> x :: go l (go r acc)
    }
  }
  go bt []
}

// left subtree, node, right subtree
fn infix_order bt {
  fn go t acc {
    match t {
      | Leaf -> acc
      | Node (l, x, r) -> go l (x :: go r acc)
    }
  }
  go bt []
}

impl showable of btree {
    fn print t {
      fn go pr pre t {
        match t {
          | Leaf -> println "leaf"
          | Node (l, x, r) -> {
              pr x;
              print pre; print "├── "; go pr (pre + "│   ") l;
              print pre; print "└── "; go pr (pre + "    ") r
          }
        }
      }
      go (^x -> println x) "" t
    }

    fn println t { print t }
}
