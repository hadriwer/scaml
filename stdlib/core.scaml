#use "stdlib/primitive.ml"

trait showable {
    type a
    fn print of a -> unit
    fn println of a -> unit
}

impl showable of string {
    fn print s { scaml_print_string s }
    fn println s { print s; scaml_print_newline () }
}

impl showable of int {
    fn print i { scaml_print_int i }
    fn println i { print i; scaml_print_newline () }
}

impl showable of float {
    fn print f { scaml_print_float f }
    fn println f { print f; scaml_print_newline () }
}

impl showable of char {
    fn print c { scaml_print_char c }
    fn println c { print c; scaml_print_newline () }
}

impl showable of bool {
    fn print b { if b then print "true" else print "false" }
    fn println b { print b; scaml_print_newline () }
}

impl showable of unit {
    fn print u { print "" }
    fn println u { scaml_print_newline () }
}

trait conversionnable {
    type a
    fn to_int       of      a -> int
    fn to_float     of      a -> float
    fn to_string    of      a -> string
}

impl conversionnable of int {
    fn to_int { Fun.id }
    fn to_float { scaml_float_of_int }
    fn to_string { string_of_int }
}

impl conversionnable of float {
    fn to_int { scaml_int_of_float }
    fn to_float { Fun.id }
    fn to_string { string_of_float }
}

trait arithm {
    op + of a -> b -> c
    op - of a -> b -> c
    op * of a -> b -> c
    op / of a -> b -> c
    op % of a -> b -> c
}

impl arithm of int, int {
    op + { scaml_add_int }
    op - { scaml_min_int }
    op * { scaml_tim_int }
    op / { scaml_div_int }
    op % { scaml_mod_int }
}

impl arithm of float, float {
    op + { scaml_add_float }
    op - { scaml_min_float }
    op * { scaml_tim_float }
    op / { scaml_div_float }
    op % { scaml_mod_float }
}

impl arithm of float, int {
    op + f i { f + (to_float i) }
    op - f i { f - (to_float i) }
    op * f i { f * (to_float i) }
    op / f i { f / (to_float i) }
    op % f i { f % (to_float i) }
}

impl arithm of int, float {
    op + i f { (to_float i) + f }
    op - i f { (to_float i) - f }
    op * i f { (to_float i) * f }
    op / i f { (to_float i) / f }
    op % i f { (to_float i) % f }
}

op < a b { scaml_lt a b }
op <= a b { scaml_leq a b }
op > a b { scaml_gt a b }
op >= a b { scaml_geq a b }
op == a b { scaml_eq a b }
op != a b { scaml_neq a b }

trait iterable {
    type a b
    fn iter of (a -> unit) -> b -> unit
    fn iteri of (int -> a -> unit) -> b -> unit
}

impl iterable of array {
    fn iter { Array.iter }
    fn iteri { Array.iteri }
}

impl iterable of list {
    fn iter { List.iter }
    fn iteri { List.iteri }
}

impl showable of array {
    fn print a {
        let l = Array.length a;
        print "[| ";
        iteri (^i e -> { 
            print e; 
            if i < (l - 1) 
            then print "; " 
            else () 
        }) a;
        print " |]"
    }

    fn println a { print a; scaml_print_newline () }
}

impl showable of list {
    fn print a {
        let l = List.length a;
        print "[ ";
        iteri (^i e -> { 
            print e; 
            if i < (l - 1) 
            then print "; " 
            else () 
        }) a;
        print " ]"
    }

    fn println a { print a; scaml_print_newline () }
}

impl showable of option {
    fn print o {
        match o {
        | None -> print "None"
        | Some x -> { print "Some "; print x }
        }
    }

    fn println o { print o; scaml_print_newline () }
}

trait foldable {
    type acc a b
    fn fold_left of (acc -> a -> acc) -> acc -> b -> acc
    fn fold_right of (a -> acc -> acc) -> b -> acc -> acc
}

impl foldable of array {
    fn fold_left { Array.fold_left }
    fn fold_right { Array.fold_right }
}

impl foldable of list {
    fn fold_left { List.fold_left }
    fn fold_right { List.fold_right }
}

trait mappable {
    type a b c
    type t of 1
    fn map of (a -> b) -> a t -> b t
    fn mapi of (int -> a -> b) -> a t -> b t
    fn map2 of (a -> b -> c) -> a t -> b t -> c t
}

impl mappable of array {
    fn map { Array.map }
    fn mapi { Array.mapi }
    fn map2 { Array.map2 }
}

impl mappable of list {
    fn map { List.map }
    fn mapi { List.mapi }
    fn map2 { List.map2 }
}

fn sum acc c { fold_left (+) acc c }

op |> f g { g f }
op :: x xs { scaml_list_cons x xs }

type a btree {
    Leaf | Node of a btree, a, a btree
}

impl foldable of btree {
    fn fold_left f acc t {
        fn go acc t {
            match t {
                | Leaf -> acc
                | Node (l, v, r) -> go (f (go acc l) v) r
            }
        }
        go acc t
    }

    fn fold_right f t acc {
        fn go t acc {
            match t {
                | Leaf -> acc
                | Node (l, v, r) -> go l (f v (go r acc))
            }
        }
        go t acc
    }
}

impl arithm of string, string {
    op + { scaml_concat_string }
}

impl arithm of string, int {
    op * a b {
        fn aux n acc {
            if n == 0 then acc else aux (n-1) (a + acc)
        }
        aux b a
    }
}

impl arithm of int, string {
    op * a b { b * a }
}

impl arithm of array, int {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of array, float {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of int, array {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of float, array {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of array, array {
    op + l1 l2 { map2 (+) l1 l2 }
    op - l1 l2 { map2 (-) l1 l2 }
    op * l1 l2 { map2 (*) l1 l2 }
    op / l1 l2 { map2 (/) l1 l2 }
    op % l1 l2 { map2 (%) l1 l2 }
}

impl arithm of list, int {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of list, float {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of int, list {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of float, list {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of list, list {
    op + l1 l2 { map2 (+) l1 l2 }
    op - l1 l2 { map2 (-) l1 l2 }
    op * l1 l2 { map2 (*) l1 l2 }
    op / l1 l2 { map2 (/) l1 l2 }
    op % l1 l2 { map2 (%) l1 l2 }
}

op @ a b { scaml_list_concat a b }

fn repeat n f x {
    fn aux n acc {
        if n == 0 then acc else aux (n-1) (f acc)
    }
    aux n x
}

type range {
    | Range of int, int, (int -> int -> bool) 
    | RangeStep of int, int, (int -> int -> bool), int
}

fn range_default_step low high { if low <= high then 1 else 0 - 1 }

fn range_step low high step {
    if step == 0 then 0
    else if low < high then (if step > 0 then step else 0)
    else if low > high then (if step < 0 then step else 0)
    else step
}

fn range_continues comp i high s {
    let inclusive = comp high high;
    if s > 0
    then (if inclusive then i <= high else i < high)
    else (if inclusive then i >= high else i > high)
}

impl arithm of range, int {
    op + r step {
        match r {
            | Range (x, y, f) -> RangeStep (x, y, f, step)
            | RangeStep (x, y, f, _) -> RangeStep (x, y, f, step)
        }
    }
    op - r step {
        match r {
            | Range (x, y, f) -> RangeStep (x, y, f, 0 - step)
            | RangeStep (x, y, f, _) -> RangeStep (x, y, f, 0 - step)
        }
    }
}

impl showable of range {
    fn print r {
        match r {
            | Range (l, h, comp) -> {
                let str = if comp 0 0 then " included." else " excluded.";
                let (l_str, h_str) = (to_string l, to_string h);
                let step_str = to_string (range_default_step l h);
                print ("Range from " + l_str + " to " +  h_str + str + " With a step of " + step_str + ".");
            }
            | RangeStep (l, h, comp, step) -> {
                let str = if comp 0 0 then " included." else " excluded.";
                let (l_str, h_str, step_str) = (to_string l, to_string h, to_string step);
                print ("Range from " + l_str + " to " +  h_str + str + " With a step of " + step_str);
            }
        }
    }

    fn println r { print r; scaml_print_newline () }
}

impl arithm of int, range {
    op + step r { r + step }
}

op .. lo hi { if lo <= hi then Range (lo, hi, (<)) else Range (lo, hi, (>)) }
op ..= lo hi { if lo <= hi then Range (lo, hi, (<=)) else Range (lo, hi, (>=)) }

impl iterable of range {
    type a = int

    fn iteri f r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i k { if range_continues comp i high s then { f k i; go (i + s) (k + 1) } else () }
            if s == 0 then () else go low 0
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn iter f r { iteri (^k i -> f i) r }
}

impl foldable of range {
    type a = int

    fn fold_left f acc r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go acc i { if range_continues comp i high s then go (f acc i) (i + s) else acc }
            if s == 0 then acc else go acc low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn fold_right f r acc {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i { if range_continues comp i high s then f i (go (i + s)) else acc }
            if s == 0 then acc else go low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }
}

impl arithm of range, range {
    op * r1 r2 {
        List.rev (fold_left (^acc e -> (fold_left (^acc' e' -> (e, e') :: acc') [] r1) @ acc) [] r2)
    }
}

trait quantifiable {
    type a b
    fn forall of (a -> bool) -> b -> bool
    fn exists of (a -> bool) -> b -> bool
}

impl quantifiable of array {
    fn forall { Array.for_all }
    fn exists { Array.exists }
}

impl quantifiable of list {
    fn forall { List.for_all }
    fn exists { List.exists }
}

impl quantifiable of range {
    type a = int

    fn forall p r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i { if range_continues comp i high s then (if p i then go (i + s) else false) else true }
            if s == 0 then true else go low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn exists p r { not (forall (^i -> not (p i)) r) }
}