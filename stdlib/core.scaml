#use "stdlib/primitive.ml"


trait indexable {
    op [] of a -> b -> c
    op []= of a -> b -> c -> unit
    op []+= of a -> b -> c -> unit
}

impl indexable of array, int {
    op [] { Array.get }
    op []= { Array.set }
    op []+= a i v { a[i] = a[i] + v }
}

impl indexable of bytes, int {
    op [] { Bytes.get }
    op []= { Bytes.set }
}

impl indexable of string, int {
    op [] { String.get }
}

trait showable {
    type a
    fn print of a -> unit
    fn println of a -> unit
}

impl showable of string {
    fn print s { scaml_print_string s }
    fn println s { print s; scaml_print_newline () }
}

impl showable of bytes {
    fn print b { scaml_print_string (Bytes.to_string b) }
    fn println b { print b; scaml_print_newline () }
}

impl showable of int {
    fn print i { scaml_print_int i }
    fn println i { print i; scaml_print_newline () }
}

impl showable of float {
    fn print f { scaml_print_float f }
    fn println f { print f; scaml_print_newline () }
}

impl showable of char {
    fn print c { scaml_print_char c }
    fn println c { print c; scaml_print_newline () }
}

impl showable of bool {
    fn print b { if b then print "true" else print "false" }
    fn println b { print b; scaml_print_newline () }
}

impl showable of unit {
    fn print u { print "" }
    fn println u { scaml_print_newline () }
}

trait conversionnable {
    type a
    fn to_int       of      a -> int
    fn to_float     of      a -> float
    fn to_string    of      a -> string
    fn to_char      of      a -> char
}

impl conversionnable of int {
    fn to_int { Fun.id }
    fn to_float { scaml_float_of_int }
    fn to_string { string_of_int }
    // The char of that code: `to_char 97` is 'a'.
    fn to_char i {
        try Char.chr i
        with { | Invalid_argument _ -> failwith (scaml_concat_string "to_char : " (scaml_concat_string (to_string i) " is not a char code (0 to 255).")) }
    }
}

impl conversionnable of float {
    fn to_int { scaml_int_of_float }
    fn to_float { Fun.id }
    fn to_string { string_of_float }
    fn to_char f { to_char (to_int f) }
}

trait arithm {
    op + of a -> b -> c
    op - of a -> b -> c
    op * of a -> b -> c
    op / of a -> b -> c
    op % of a -> b -> c
}

impl arithm of int, int {
    op + { scaml_add_int }
    op - { scaml_min_int }
    op * { scaml_tim_int }
    op / { scaml_div_int }
    op % { scaml_mod_int }
}

impl arithm of float, float {
    op + { scaml_add_float }
    op - { scaml_min_float }
    op * { scaml_tim_float }
    op / { scaml_div_float }
    op % { scaml_mod_float }
}

impl arithm of float, int {
    op + f i { f + (to_float i) }
    op - f i { f - (to_float i) }
    op * f i { f * (to_float i) }
    op / f i { f / (to_float i) }
    op % f i { f % (to_float i) }
}

impl arithm of int, float {
    op + i f { (to_float i) + f }
    op - i f { (to_float i) - f }
    op * i f { (to_float i) * f }
    op / i f { (to_float i) / f }
    op % i f { (to_float i) % f }
}

op < a b { scaml_lt a b }
op <= a b { scaml_leq a b }
op > a b { scaml_gt a b }
op >= a b { scaml_geq a b }
op == a b { scaml_eq a b }
op != a b { scaml_neq a b }

trait powerable {
    op ** of a -> b -> c
}

impl powerable of int, int {
    op ** x n {
        if n < 0 then failwith "error ** : negative exponent on an int, use floats"
        else if n == 2 then x * x
        else {
            fn aux acc b n {
                if n == 0 then acc
                else aux (if n % 2 == 1 then acc * b else acc) (b * b) (n / 2)
            }
            aux 1 x n
        }
    }
}

impl powerable of float, float {
    op ** { Float.pow }
}

impl powerable of float, int {
    op ** x n { Float.pow x (to_float n) }
}

impl powerable of int, float {
    op ** x y { Float.pow (to_float x) y }
}

trait iterable {
    type a b
    fn iter of (a -> unit) -> b -> unit
    fn iteri of (int -> a -> unit) -> b -> unit
}

impl iterable of array {
    fn iter { Array.iter }
    fn iteri { Array.iteri }
}

impl iterable of list {
    fn iter { List.iter }
    fn iteri { List.iteri }
}

impl iterable of string {
    type a = char
    fn iter { String.iter }
    fn iteri { String.iteri }
}

impl showable of array {
    fn print a {
        print "[| ";
        iteri (^i e -> {
            if i > 0 then print "; " else ();
            print e
        }) a;
        print " |]"
    }

    fn println a { print a; scaml_print_newline () }
}

impl showable of list {
    fn print a {
        print "[ ";
        iteri (^i e -> {
            if i > 0 then print "; " else ();
            print e
        }) a;
        print " ]"
    }

    fn println a { print a; scaml_print_newline () }
}

impl showable of option {
    fn print o {
        match o {
        | None -> print "None"
        | Some x -> { print "Some "; print x }
        }
    }

    fn println o { print o; scaml_print_newline () }
}

trait foldable {
    type acc a b
    fn fold_left of (acc -> a -> acc) -> acc -> b -> acc
    fn fold_right of (a -> acc -> acc) -> b -> acc -> acc
}

impl foldable of array {
    fn fold_left { Array.fold_left }
    fn fold_right { Array.fold_right }
}

impl foldable of list {
    fn fold_left { List.fold_left }
    fn fold_right { List.fold_right }
}

impl foldable of string {
  type a = char
  fn fold_left { String.fold_left }
  fn fold_right { String.fold_right }
}

trait mappable {
    type a b c
    type t of 1
    fn map of (a -> b) -> a t -> b t
    fn mapi of (int -> a -> b) -> a t -> b t
    fn map2 of (a -> b -> c) -> a t -> b t -> c t
}

impl mappable of array {
    fn map { Array.map }
    fn mapi { Array.mapi }
    fn map2 { Array.map2 }
}

impl mappable of list {
    fn map { List.map }
    fn mapi { List.mapi }
    fn map2 { List.map2 }
}

fn sum acc c { fold_left (+) acc c }

op |> f g { g f }
op :: x xs { scaml_list_cons x xs }

impl arithm of string, string {
    op + { scaml_concat_string }
}

impl arithm of string, int {
    op * a b {
        fn aux n acc {
            if n == 0 then acc else aux (n-1) (a + acc)
        }
        aux b ""
    }
}

impl arithm of int, string {
    op * a b { b * a }
}

impl conversionnable of option {
    fn to_int o { match o { None -> 1 | Some _ -> 0 } }
    fn to_float o { to_float (to_int o) }
    fn to_string o { match o { None -> "None" | Some w -> "Some " + (to_string w)} }
    fn to_char o { match o { None -> failwith "to_char : None has no char." | Some w -> to_char w } }
}

impl arithm of array, int {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of array, float {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of int, array {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of float, array {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of array, array {
    op + l1 l2 { map2 (+) l1 l2 }
    op - l1 l2 { map2 (-) l1 l2 }
    op * l1 l2 { map2 (*) l1 l2 }
    op / l1 l2 { map2 (/) l1 l2 }
    op % l1 l2 { map2 (%) l1 l2 }
}

impl arithm of list, int {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of list, float {
    op + arr el { map (^x -> x + el) arr }
    op - arr el { map (^x -> x - el) arr }
    op * arr el { map (^x -> x * el) arr }
    op / arr el { map (^x -> x / el) arr }
    op % arr el { map (^x -> x % el) arr }
}

impl arithm of int, list {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of float, list {
    op + el arr { map (^x -> el + x) arr }
    op - el arr { map (^x -> el - x) arr }
    op * el arr { map (^x -> el * x) arr }
    op / el arr { map (^x -> el / x) arr }
    op % el arr { map (^x -> el % x) arr }
}

impl arithm of list, list {
    op + l1 l2 { map2 (+) l1 l2 }
    op - l1 l2 { map2 (-) l1 l2 }
    op * l1 l2 { map2 (*) l1 l2 }
    op / l1 l2 { map2 (/) l1 l2 }
    op % l1 l2 { map2 (%) l1 l2 }
}

trait concetanable {
    type a
    op @ of a -> a -> a
}

impl concetanable of list {
    op @ a b { scaml_list_concat a b }
}

impl concetanable of array {
    op @ a b { Array.append a b }
}

fn repeat n f x {
    fn aux n acc {
        if n == 0 then acc else aux (n-1) (f acc)
    }
    aux n x
}

type range {
    | Range of int, int, (int -> int -> bool) 
    | RangeStep of int, int, (int -> int -> bool), int
}

fn range_default_step low high { if low <= high then 1 else 0 - 1 }

fn range_step low high step {
    if step == 0 then 0
    else if low < high then (if step > 0 then step else 0)
    else if low > high then (if step < 0 then step else 0)
    else step
}

fn range_continues comp i high s {
    let inclusive = comp high high;
    if s > 0
    then (if inclusive then i <= high else i < high)
    else (if inclusive then i >= high else i > high)
}

impl arithm of range, int {
    op + r step {
        match r {
            | Range (x, y, f) -> RangeStep (x, y, f, step)
            | RangeStep (x, y, f, _) -> RangeStep (x, y, f, step)
        }
    }
    op - r step {
        match r {
            | Range (x, y, f) -> RangeStep (x, y, f, 0 - step)
            | RangeStep (x, y, f, _) -> RangeStep (x, y, f, 0 - step)
        }
    }
}

impl showable of range {
    fn print r {
        match r {
            | Range (l, h, comp) -> {
                let str = if comp 0 0 then " included." else " excluded.";
                let (l_str, h_str) = (to_string l, to_string h);
                let step_str = to_string (range_default_step l h);
                print ("Range from " + l_str + " to " +  h_str + str + " With a step of " + step_str + ".");
            }
            | RangeStep (l, h, comp, step) -> {
                let str = if comp 0 0 then " included." else " excluded.";
                let (l_str, h_str, step_str) = (to_string l, to_string h, to_string step);
                print ("Range from " + l_str + " to " +  h_str + str + " With a step of " + step_str);
            }
        }
    }

    fn println r { print r; scaml_print_newline () }
}

impl arithm of int, range {
    op + step r { r + step }
}

op .. lo hi { if lo <= hi then Range (lo, hi, (<)) else Range (lo, hi, (>)) }
op ..= lo hi { if lo <= hi then Range (lo, hi, (<=)) else Range (lo, hi, (>=)) }

impl iterable of range {
    type a = int

    fn iteri f r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i k { if range_continues comp i high s then { f k i; go (i + s) (k + 1) } else () }
            if s == 0 then () else go low 0
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn iter f r { iteri (^k i -> f i) r }
}

impl foldable of range {
    type a = int

    fn fold_left f acc r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go acc i { if range_continues comp i high s then go (f acc i) (i + s) else acc }
            if s == 0 then acc else go acc low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn fold_right f r acc {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i { if range_continues comp i high s then f i (go (i + s)) else acc }
            if s == 0 then acc else go low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }
}

impl arithm of range, range {
    op * r1 r2 {
        List.rev (fold_left (^acc e -> (fold_left (^acc' e' -> (e, e') :: acc') [] r1) @ acc) [] r2)
    }
}

trait quantifiable {
    type a b
    fn forall of (a -> bool) -> b -> bool
    fn exists of (a -> bool) -> b -> bool
}

impl quantifiable of array {
    fn forall { Array.for_all }
    fn exists { Array.exists }
}

impl quantifiable of list {
    fn forall { List.for_all }
    fn exists { List.exists }
}

impl quantifiable of range {
    type a = int

    fn forall p r {
        fn walk low high comp step {
            let s = range_step low high step;
            fn go i { if range_continues comp i high s then (if p i then go (i + s) else false) else true }
            if s == 0 then true else go low
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }

    fn exists p r { not (forall (^i -> not (p i)) r) }
}

trait sizable {
    fn len of a -> int
}

impl sizable of int {
  fn len i { (to_int (floor (log10 (to_float i)))) + 1 }
}

impl sizable of array {
    fn len { Array.length }
}

impl sizable of list {
    fn len { List.length }
}

impl sizable of string {
    fn len { String.length }
}

// `-x` (prefix minus) on anything but a literal number is `neg x`.
trait negatable {
    type a
    fn neg of a -> a
}

impl negatable of int {
    fn neg { scaml_neg_int }
}

impl negatable of float {
    fn neg { scaml_neg_float }
}

impl negatable of array {
    fn neg arr { Array.map (^x -> neg x) arr }
}

impl negatable of list {
    fn neg l { List.map (^x -> neg x) l }
}

// How many indices `low`, `low + st`, ... a range goes through before
// [range_continues] stops it.
fn range_count low high comp st {
    let inclusive = comp high high;
    if st > 0 then {
        let bound = if inclusive then high + 1 else high;
        if bound <= low then 0 else (bound - low + st - 1) / st
    } else if st < 0 then {
        let bound = if inclusive then high - 1 else high;
        if bound >= low then 0 else (low - bound - st - 1) / (0 - st)
    } else 0
}

impl indexable of string, range {
    // Built in one go (`String.sub` for a step of 1), not char by char.
    op [] s r {
        fn walk low high comp step {
            let st = range_step low high step;
            let n = range_count low high comp st;
            if st == 1 then String.sub s low n
            else String.init n (^k -> s[low + k * st])
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }
}

impl indexable of array, range {
    op [] a r {
        fn walk low high comp step {
            let st = range_step low high step;
            fn go acc i {
                if range_continues comp i high st
                then go (Array.get a i :: acc) (i + st)
                else acc
            }
            if st == 0 then [||] else Array.of_list (List.rev (go [] low))
        }
        match r {
            | Range (low, high, comp) -> walk low high comp (range_default_step low high)
            | RangeStep (low, high, comp, step) -> walk low high comp step
        }
    }
}

fn maxn a b { if a > b then a else b }
fn minn a b { if a < b then a else b }

trait extremable {
    type i a b
    fn max of b -> a
    fn min of b -> a
    fn argmax of b -> i
    fn argmin of b -> i
}

impl extremable of array {
    type i = int
    fn max a {
        try Array.fold_left (^acc e -> if e > acc then e else acc) a[0] a
        with { | Invalid_argument _ -> failwith "error max : empty array can not have a maximum value." }
    }
    fn min a {
        try Array.fold_left (^acc e -> if e < acc then e else acc) a[0] a
        with { | Invalid_argument _ -> failwith "error min : empty array can not have a minimum value." }
    }
    fn argmax a {
        try fst (fold_left (^acc i -> if a[i] > snd acc then (i, a[i]) else acc) (0, a[0]) (0..len a))
        with { | Invalid_argument _ -> failwith "error argmax : empty array can not have a argmax." }
    }
    fn argmin a {
        try fst (fold_left (^acc i -> if a[i] < snd acc then (i, a[i]) else acc) (0, a[0]) (0..len a))
        with { | Invalid_argument _ -> failwith "error argmin : empty array can not have a argmin." }
    }
}

impl conversionnable of string {
  fn to_int { scaml_int_of_string }
  fn to_float { scaml_float_of_string }
  fn to_string s { s }
  // A string of exactly one char: `to_char "a"` is 'a'.
  fn to_char s {
    if String.length s == 1 then s[0]
    else failwith "to_char : the string must have exactly one char."
  }
}

impl conversionnable of bool {
  fn to_int b { if b then 1 else 0 }
  fn to_float b { if b then 1. else 0. }
  fn to_string b { if b then "true" else "false" }
  fn to_char _ { failwith "to_char : unsupported on bool." }
}

trait filterable {
  type a
  type t of 1
  fn filter of (a -> bool) -> a t -> a t
}

impl filterable of array {
  fn filter p arr { Array.of_list (List.filter p (Array.to_list arr)) }
}

impl filterable of list {
  fn filter { List.filter }
}

fn compare e1 e2 { scaml_compare e1 e2 }

trait sortable {
  type a
  type t of 1
  fn sort of (a -> a -> int) -> a t -> a t
}

impl sortable of array {
  fn sort cmp arr { let c = Array.copy arr; Array.sort cmp c; c }
}

impl sortable of list {
  fn sort { List.sort }
}

fn split_apply_on_char f c s {
  let l = len s;
  fn aux acc beg end {
    if end >= l then List.rev ((f s[beg..end])::acc)
    else {
      if s[end] == c
      then
        aux ((f s[beg..end])::acc) (end+1) (end+1)
      else
        aux acc beg (end+1)
    }
  }
  aux [] 0 0
}

impl conversionnable of list {
  fn to_int _ { failwith "to_int : unsupported on list." }
  fn to_float _ { failwith "to_float : unsupported on list." }
  fn to_string l {
    fn aux acc l' { match l' {
      | [] -> acc
      | x::xs -> aux (acc + "; " + (to_string x)) xs
    }}
    match l {
      | [] -> "[  ]"
      | x::xs -> "[ " + (aux (to_string x) xs) + " ]"
    }
  }
  fn to_char _ { failwith "to_char : unsupported on list." }
}

impl conversionnable of char {
  fn to_int c { Char.code c }
  fn to_float c { scaml_float_of_int (Char.code c) }
  fn to_string c { String.make 1 c }
  fn to_char c { c }
}

impl conversionnable of bytes {
  fn to_int _ { failwith "to_int : unsupported on bytes." }
  fn to_float _ { failwith "to_float : unsupported on bytes." }
  fn to_string b { Bytes.to_string b }
  fn to_char b {
    if Bytes.length b == 1 then b[0]
    else failwith "to_char : the bytes must have exactly one char."
  }
}

impl conversionnable of unit {
  fn to_int _ { 0 }
  fn to_float _ { 0. }
  fn to_string _ { "()" }
  fn to_char _ { failwith "to_char : unsupported on unit." }
}

impl conversionnable of array {
  fn to_int _ { failwith "to_int : unsupported on array." }
  fn to_float _ { failwith "to_float : unsupported on array." }
  fn to_string a {
    let n = Array.length a;
    fn aux acc i {
      if i >= n then acc
      else aux (acc + "; " + (to_string a[i])) (i + 1)
    }
    if Array.length a == 0 then "[|  |]"
    else "[| " + (aux (to_string a[0]) 1) + " |]"
  }
  fn to_char _ { failwith "to_char : unsupported on array." }
}

impl conversionnable of range {
  fn to_int _ { failwith "to_int : unsupported on range." }
  fn to_float _ { failwith "to_float : unsupported on range." }
  fn to_string r {
    match r {
      | Range (l, h, comp) -> {
        let str = if comp 0 0 then " included." else " excluded.";
        "Range from " + (to_string l) + " to " + (to_string h) + str + " With a step of " + (to_string (range_default_step l h)) + "."
      }
      | RangeStep (l, h, comp, step) -> {
        let str = if comp 0 0 then " included." else " excluded.";
        "Range from " + (to_string l) + " to " + (to_string h) + str + " With a step of " + (to_string step)
      }
    }
  }
  fn to_char _ { failwith "to_char : unsupported on range." }
}

fn apply_option f o1 o2 {
  match o1, o2 {
    | None, None -> None
    | Some x, None | None, Some x -> Some x
    | Some x, Some y -> Some (f x y)
  }
}

impl arithm of option, option {
  op + o1 o2 { apply_option (^x y -> x + y) o1 o2 }
  op - o1 o2 { apply_option (^x y -> x - y) o1 o2 }
  op * o1 o2 { apply_option (^x y -> x * y) o1 o2 }
  op / o1 o2 { apply_option (^x y -> x / y) o1 o2 }
  op % o1 o2 { apply_option (^x y -> x % y) o1 o2 }
}
