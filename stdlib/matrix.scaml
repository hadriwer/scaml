type a matrix {
    arr of a array array ;
    shape of (int, int)
}

fn copy_ m {
    Array.map Array.copy m
}

fn print_shape m {
    println m.shape;
}

fn make_matrix n m e {
    { arr = Array.make_matrix n m e ; shape = (n, m) }
}

fn transpose_ a {
    let rows = Array.length a;
    let cols = if rows == 0 then 0 else Array.length (a[0]);
    Array.init_matrix cols rows (^i j -> a[j,i])
}

fn transpose m {
    let (x, y) = m.shape;
    { arr = transpose_ m.arr ; shape = (y, x) }
}

fn init_matrix n m f {
    { arr = Array.init_matrix n m f ; shape = (n, m) }
}

fn identity n {
    { arr = Array.init_matrix n n (^i j -> if i == j then 1 else 0) ; shape = (n, n) }
}

impl concetanable of matrix {
    op @ m1 m2 {
        let (x, y) = m1.shape;
        let (x', y') = m2.shape;
        if y != y'
        then
            failwith "error operator '@' : impossible to concatenate matrix with different column size."
        else {
            { arr = m1.arr @ m2.arr; shape = (x + x', y) }
        }
    }
}

impl indexable of matrix, int {
    op [] m i { m.arr[i] }
    op []= m i row { m.arr[i] = row }
    op []+= m i v { m.arr[i] = m.arr[i] + v }
}

impl iterable of matrix {
    fn iter f m { Array.iter (^row -> Array.iter f row) m.arr }
    fn iteri f m {
        let (_, cols) = m.shape;
        Array.iteri (^i row -> Array.iteri (^j x -> f (i * cols + j) x) row) m.arr
    }
}

impl mappable of matrix {
    fn map f m {
        { arr = map (map f) m.arr; shape = m.shape }
    }
    fn mapi f m {
        let (_, cols) = m.shape;
        { arr = mapi (^i row -> mapi (^j x -> f (i * cols + j) x) row) m.arr; shape = m.shape }
    }
    fn map2 f m1 m2 {
        { arr = map2 (map2 f) m1.arr m2.arr; shape = m1.shape }
    }
}

impl arithm of matrix, matrix {
    op + m1 m2 { { arr = m1.arr + m2.arr; shape = m1.shape } }
    op - m1 m2 { { arr = m1.arr - m2.arr; shape = m1.shape } }
    op * m1 m2 { { arr = m1.arr * m2.arr; shape = m1.shape } }
    op / m1 m2 { { arr = m1.arr / m2.arr; shape = m1.shape } }
    op % m1 m2 { { arr = m1.arr % m2.arr; shape = m1.shape } }
}

impl arithm of matrix, int {
    op + m1 i { { arr = m1.arr + i; shape = m1.shape } }
    op - m1 i { { arr = m1.arr - i; shape = m1.shape } }
    op * m1 i { { arr = m1.arr * i; shape = m1.shape } }
    op / m1 i { { arr = m1.arr / i; shape = m1.shape } }
    op % m1 i { { arr = m1.arr % i; shape = m1.shape } }
}

impl arithm of int, matrix {
    op + i m { { arr = i + m.arr; shape = m.shape } }
    op - i m { { arr = i - m.arr; shape = m.shape } }
    op * i m { { arr = i * m.arr; shape = m.shape } }
    op / i m { { arr = i / m.arr; shape = m.shape } }
    op % i m { { arr = i % m.arr; shape = m.shape } }
}

impl showable of matrix {
    fn print m {
        let strs = Array.map (^row -> Array.map (^x -> to_string x) row) m.arr;
        let (_, cols) = m.shape;
        // one width per column, so a wide cell doesn't stretch the others
        let widths = Array.make cols 0;
        iter (^row -> iteri (^j s -> widths[j] = Stdlib.max widths[j] (String.length s)) row) strs;

        // numbers are right-aligned, anything else (None, Some x, ...) left-aligned
        fn is_number s {
            if String.length s == 0 then false
            else {
                let c = Char.code (s[0]);
                (c >= 48 && c <= 57) || c == 45
            }
        }

        iteri (^i row -> {
            if i > 0 then print "\n" else ();
            iteri (^j s -> {
                if j > 0 then print "  " else ();
                let pad = String.make (widths[j] - String.length s) (Char.chr 32);
                if is_number s then { print pad; print s; }
                else { print s; if j < cols - 1 then print pad else (); }
            }) row;
        }) strs;
        println ();
    }

    fn println m { print m; println (); }
}

fn trace m {
    let (x, y) = m.shape;

    if x != y || x == 0
    then
        failwith "error trace : matrix must be square and not empty so shape.x == shape.y > 0"
    else
        fold_left (^acc i -> m[i,i] + acc) m[0,0] (1..x)
}

op *. m1 m2 {
    let (m, n) = m1.shape;
    let (n', p) = m2.shape;
    if n != n' || n == 0
    then
        failwith "error operator '*.' : the number of columns of m1 must equal the number of rows of m2."
    else
        init_matrix m p (^i j ->
            fold_left (^acc k -> acc + m1[i, k] * m2[k, j]) (m1[i, 0] * m2[0, j]) (1..n))
}

// Product of two n x n float array array.
fn eig_mul_ a b n {
    Array.init_matrix n n (^i j -> fold_left (^acc k -> acc + a[i,k] * b[k,j]) 0. (0..n))
}

// Householder QR of an n x n float array array: a = q * r, q orthogonal,
// r upper triangular.
fn eig_qr_ a n {
    let r = copy_ a;
    let q = Array.init_matrix n n (^i j -> if i == j then 1. else 0.);

    iter (^k -> {
        // v = x - alpha e_k, x the column k of r below the diagonal
        let norm_x = sqrt (fold_left (^acc i -> acc + r[i,k] * r[i,k]) 0. (k..n));
        let alpha = if r[k,k] >= 0. then 0. - norm_x else norm_x;
        let v = Array.init n (^i -> if i < k then 0. else if i == k then r[i,k] - alpha else r[i,k]);
        let norm_v = sqrt (fold_left (^acc i -> acc + v[i] * v[i]) 0. (k..n));

        if norm_v > 0.000000000001 then {
            iter (^i -> v[i] = v[i] / norm_v) (k..n);
            // r = h r and q = q h, with h = I - 2 v v^T
            iter (^j -> {
                let d = fold_left (^acc i -> acc + v[i] * r[i,j]) 0. (k..n);
                iter (^i -> r[i,j] = r[i,j] - 2. * d * v[i]) (k..n);
            }) (0..n);
            iter (^i -> {
                let d = fold_left (^acc j -> acc + q[i,j] * v[j]) 0. (k..n);
                iter (^j -> q[i,j] = q[i,j] - 2. * d * v[j]) (k..n);
            }) (0..n);
        }
        else ()
    }) (0..n);
    (q, r)
}

// Eigenvalues and eigenvectors of a square matrix, as numpy's
// `w, v = np.linalg.eig(m)`: returns (w, v), w the array of eigenvalues and
// v the matrix whose column k is the (unit) eigenvector of w[k].
// QR algorithm, so only real eigenvalues: fails if it doesn't converge
// (e.g. a rotation, whose eigenvalues are complex).
fn eig m {
    let (n, n') = m.shape;
    if n != n' || n == 0
    then
        failwith "error eig : matrix must be square so shape.x == shape.y"
    else {
        let max_iter, tol = 10000, 0.0000000001;
        let a0 = Array.map (^row -> Array.map (^x -> to_float x) row) m.arr;

        // biggest coefficient under the diagonal: 0 once a is triangular
        fn lower_off a {
            fold_left (^acc i -> fold_left (^acc j -> Stdlib.max acc (abs_float a[i,j])) acc (0..i)) 0. (0..n)
        }

        // a_{k+1} = r q = q^T a_k q, so a_0 = qs a_k qs^T
        fn iterate a qs it {
            if lower_off a < tol then (a, qs)
            else if it >= max_iter then failwith "error eig : no convergence, the eigenvalues may be complex."
            else {
                let (q, r) = eig_qr_ a n;
                iterate (eig_mul_ r q n) (eig_mul_ qs q n) (it + 1)
            }
        }
        let (t, qs) = iterate a0 (Array.init_matrix n n (^i j -> if i == j then 1. else 0.)) 0;

        let w = Array.init n (^k -> t[k,k]);

        // eigenvector of t for w[k]: y[k] = 1, y[j] = 0 for j > k, and
        // back-substitution for j < k; then the one of m is qs y
        fn eigenvector k {
            let y = Array.make n 0.;
            y[k] = 1.;
            fn back j {
                if j < 0 then ()
                else {
                    let s = fold_left (^acc l -> acc + t[j,l] * y[l]) 0. ((j + 1)..=k);
                    let d = t[j,j] - w[k];
                    let d = if abs_float d < tol then tol else d;
                    y[j] = (0. - s) / d;
                    back (j - 1)
                }
            }
            back (k - 1);
            let v = Array.init n (^i -> fold_left (^acc l -> acc + qs[i,l] * y[l]) 0. (0..n));
            let norm = sqrt (fold_left (^acc x -> acc + x * x) 0. v);
            Array.map (^x -> x / norm) v
        }
        let vs = Array.init n eigenvector;

        (w, init_matrix n n (^i k -> vs[k][i]))
    }
}

impl extremable of matrix {
    type i = (int, int)
    fn max m {
        try fold_left (^acc row -> { let mr = max row; if mr > acc then mr else acc }) m[0,0] m.arr
        with {
            | Invalid_argument _ -> failwith "error max : empty matrix can not have a maximum value."
        }
    }
    fn min m {
        try fold_left (^acc row -> { let mr = min row; if mr < acc then mr else acc }) m[0,0] m.arr
        with {
            | Invalid_argument _ -> failwith "error min : empty matrix can not have a minimum value."
        }
    }
    fn argmax m {
        let (rows, cols) = m.shape;
        try fst (fold_left (^acc k -> {
            let e = m[k / cols, k % cols];
            if e > snd acc then ((k / cols, k % cols), e) else acc
        }) ((0, 0), m[0,0]) (0..(rows * cols)))
        with { 
            | Invalid_argument _ -> failwith "error argmax : empty matrix can not have a argmax." 
        }
    }
    fn argmin m {
        let (rows, cols) = m.shape;
        try fst (fold_left (^acc k -> {
            let e = m[k / cols, k % cols];
            if e < snd acc then ((k / cols, k % cols), e) else acc
        }) ((0, 0), m[0,0]) (0..(rows * cols)))
        with { 
            | Invalid_argument _ -> failwith "error argmin : empty matrix can not have a argmin." 
        }
    }
}

impl sortable of matrix {
  fn sort cmp m { { arr = map (sort cmp) m.arr; shape = m.shape } }
}

trait conversionnable_matrix {
  type b a
  fn to_matrix of a -> b matrix
}

impl conversionnable_matrix of e array {
  type b = e
  fn to_matrix a {
    let l = len a;
    { arr = Array.map (^x -> [| x |]) a ; shape = (l, 1) }
  }
}

impl conversionnable_matrix of e array array {
  type b = e
  fn to_matrix rows {
    let cols = if len rows == 0 then 0 else len rows[0];
    { arr = rows ; shape = (len rows, cols) }
  }
}
