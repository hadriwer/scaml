#use "stdlib/matrix.scaml"

let pi = 3.14159265358979323846;

fn relu x { maxn 0. x }

fn leaky_relu ?(alpha=0.01) x { maxn (alpha * x) x }

fn sigmoid x { 1 / (1 + exp (-x)) }

fn silu x { sigmoid x * x }

fn tanh x {
  let pose, nege = exp x, exp (-x);
  (pose - nege) / (pose + nege)
}

fn softmax ?axis x {
  along axis (^v -> { let e = map exp (v - fold_left maxn v[0] v); e / sum 0. e }) x
}

fn is_close ?(rel_tol=1e-9) ?(abs_tol=1e-9) a b {
  a == b || abs_float (a - b) <= maxn (rel_tol * maxn (abs_float a) (abs_float b)) abs_tol
}

fn cross_entropy p q {
  let pq = p * (map log q);
  - (sum 0. pq)
}

fn mean ?n v {
  let n = match n {| None -> len v | Some n -> n };
  (sum 0. v) / n
}

fn var ?n v {
  let n = match n {| None -> len v | Some n -> n};
  let m = mean v;

  fold_left (^acc e -> (e - m)**2. + acc) 0. v / n
}

fn layer_norm ?axis ?(epsilon=1e-5) ?(gamma=1.) ?(beta=0.) x {
  along axis (^v -> {
    let length = len v;
    let m = mean n=length v;
    let s = var n=length v;
    map (^e -> (e - m) / (sqrt (s + epsilon)) * gamma + beta) v
  }) x
}

fn uniform a b {
  if a >= b then failwith "error uniform : a should be strictly less then b"
  else
    a + Random.float (b - a)
}
