{
  "name": "scaml",
  "displayName": "SCaml",
  "description": "Syntax highlighting for SCaml (Simple Caml)",
  "version": "0.1.0",
  "publisher": "wer",
  "license": "MIT",
  "icon": "images/icon-128.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scaml",
        "aliases": [
          "SCaml",
          "scaml"
        ],
        "extensions": [
          ".scaml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "scaml",
        "scopeName": "source.scaml",
        "path": "./syntaxes/scaml.tmLanguage.json"
      }
    ]
  }
}
