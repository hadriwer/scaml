=== run/determinize.scaml
<Deterministic Finite Automaton : 
Q = [| [ 0 ]; [ 0; 1 ]; [ 0; 2 ] |]
Σ = [ "b"; "a" ]
q₀ = [ 0 ]
F = [ [ 0; 2 ] ]
δ = 
  [ 0 ] -a-> [ 0 ]
  [ 0 ] -b-> [ 0; 1 ]
  [ 0; 1 ] -a-> [ 0; 2 ]
  [ 0; 1 ] -b-> [ 0; 1 ]
  [ 0; 2 ] -a-> [ 0 ]
  [ 0; 2 ] -b-> [ 0; 1 ]
>
abba -> true
ba -> true
ab -> false
bab -> false
 -> false
<Deterministic Finite Automaton : 
Q = [| [ "q0" ]; [ "q1"; "q2" ]; [ "q2" ]; [ "q2"; "q3" ] |]
Σ = [ "c"; "b"; "a" ]
q₀ = [ "q0" ]
F = [ [ "q2"; "q3" ] ]
δ = 
  [ "q0" ] -a-> [ "q1"; "q2" ]
  [ "q1"; "q2" ] -a-> [ "q2" ]
  [ "q1"; "q2" ] -b-> [ "q2"; "q3" ]
  [ "q1"; "q2" ] -c-> [ "q2" ]
  [ "q2" ] -a-> [ "q2" ]
  [ "q2" ] -b-> [ "q2"; "q3" ]
  [ "q2" ] -c-> [ "q2" ]
  [ "q2"; "q3" ] -a-> [ "q2" ]
  [ "q2"; "q3" ] -b-> [ "q2"; "q3" ]
  [ "q2"; "q3" ] -c-> [ "q2" ]
>
ab -> true
abab -> true
acccb -> true
abx -> false
a -> false
ba -> false
init_dfa : two transitions from the same state by the letter "a", the automaton isn't deterministic: use determinize.
=== run/dfa.scaml
<Deterministic Finite Automaton : 
Q = [| 0; 1 |]
Σ = [ "b"; "a" ]
q₀ = 0
F = [ 1 ]
δ = 
  0 -a-> 0
  0 -b-> 1
  1 -a-> 1
  1 -b-> 0
>
true
<Deterministic Finite Automaton : 
Q = [| "even"; "odd" |]
Σ = [ "b"; "a" ]
q₀ = "even"
F = [ "odd" ]
δ = 
  "even" -a-> "even"
  "even" -b-> "odd"
  "odd" -a-> "odd"
  "odd" -b-> "even"
>
false
