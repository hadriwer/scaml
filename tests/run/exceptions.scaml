// try / with
fn safe_div a b {
    try a / b
    with { | Division_by_zero -> 0 }
}

fn main {
    println (safe_div 10 2);
    println (safe_div 1 0);
    let r = try failwith "boom" with { | Failure msg -> msg };
    println r;
    let a = [|1|];
    println (try a[5] with { | Invalid_argument _ -> -1 });
}
