// arithm overloads between ints, floats, strings, arrays and lists
fn main {
    println (1 + 2);
    println (1.5 + 2.);
    println (1 + 2.5);
    println (2.5 * 2);
    println ("ab" + "cd");
    println ("ab" * 3);
    println (2 * "xy");
    println ("ab" * 0);
    println ([|1; 2; 3|] * 2);
    println ([|1; 2|] + [|10; 20|]);
    println ([1; 2] + 1.5);
    println (-(3 + 1));
    println (neg [|1; -2|]);
}
