// char literals: any character, OCaml's escapes; `!=` is `==`'s negation
fn main () {
  let x = "1  2 3";
  let spl = x |> String.split_on_char ' ' |> List.filter ((!=) "") |> List.map int_of_string;
  println spl;
  println (String.split_on_char ',' "a,b");
  println ['a'; ' '; '1'; '\''; '\\'; '"'];
  print (String.make 2 '\t');
  println '|';
  println (match ' ' { ' ' -> "space" | _ -> "other" });
  println ("a" != "a");
  println ("a" != "b");
  let x' = 3;
  println x';
}
