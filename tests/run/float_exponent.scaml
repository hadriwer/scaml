#use "stdlib/math.scaml"
// Floats with an exponent, as in OCaml: `1e-6`, `2.5E3`, `1.e2`.
let eps = 1e-6;

fn main () {
  println eps;
  println 1e6;
  println 2.5E3;
  println 1.e2;
  println (1e+3 + 1);
  println (-1e-3);
  let x = 3.;
  println (x-1e-1);
  println (0..3);
  println (fold_left (+) 0 (0..3));
  let a = [| 1.5e2; 2E-1 |];
  println a;
  let x1e5 = 4;
  println x1e5;
  println (is_close 0.1 (0.1 + 1e-12));
}
