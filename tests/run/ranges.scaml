// ranges, steps, and slices of arrays and strings
fn main () {
    println (0..5);
    iter print (0..5);
    println "";
    iter print (0..=5);
    println "";
    iter print (5..0);
    println "";
    iter print ((0..=10) + 2);
    println "";
    iter print ((10..=0) - 5);
    println "";
    println (fold_left (+) 0 (1..=100));
    println (forall (^i -> i < 10) (0..10));
    println (exists (^i -> i == 3) (0..3));
    let a = [|10; 20; 30; 40; 50|];
    println a[1..3];
    println a[4..=0];
    println a[(0..5) + 2];
    let s = "abcdef";
    println s[1..4];
    println s[2];
    let (x, y, z) = (0..3);
    println (x + y + z);
}
