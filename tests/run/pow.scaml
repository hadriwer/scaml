#use "stdlib/math.scaml"

// `**` on int (by squaring), on float, and mixed

fn main () {
  println (2 ** 10);
  println (3 ** 0);
  println ((-2) ** 3);
  println (7 ** 1);
  println (2. ** 0.5);
  println (2. ** (-1.));
  println (2. ** 3);
  println (2 ** 0.5);
  println (2. ** (-1));
  println (var [|1.; 2.; 3.; 4.|]);
}
