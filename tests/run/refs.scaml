// References: `ref e`, `*r` for the value, `r = e` to change it, in a
// block, a lambda, an array cell and a record field; a record literal
// still built from `{ x = .. }`; printing and converting a ref; `+=`
// and the other compound assignments.

type point { x of int; y of int }
type node { value of int; next of int ref }

fn counter () {
  let n = ref 0;
  ^() -> { n = *n + 1; *n }
}

fn main () {
  let r = ref 0;
  r = 1;
  println (*r);
  r = *r * 10 + 2;
  println (*r);
  println (2 * *r);
  println (3*(*r));
  let t = [| ref 1; ref 2 |];
  t[0] = ref 5;
  println (*t[0] + *t[1]);
  let nd = { value = 1; next = ref 7 };
  nd.next = 8;
  println (*nd.next + nd.value);
  let p = { x = 1; y = 2 };
  println (p.x + p.y);
  let next = counter ();
  next ();
  println (next ());
  let total = ref 0;
  iter (^i -> total = *total + i) (1..=4);
  println (*total);
  if *total > 5 then { total = 0; println (*total) } else ();
  println r;
  println [| ref 1.5; ref 2. |];
  println (ref (Some "a"));
  println (to_string r + "!");
  println (to_float r);
  println (to_char (ref 97));
  let c = ref 1;
  c += 1 + 2 * 3;
  println c;
  c -= 4; c *= 3; c /= 2; c %= 4; c **= 3;
  println c;
  let s = ref "a";
  s += "b";
  println (*s);
  let l = ref [1];
  l @= [2; 3];
  println l;
  let arr = [| 1; 2 |];
  arr[0] += 10;
  println arr;
}
