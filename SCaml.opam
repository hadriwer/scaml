# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "A functional language with a Rust-inspired syntax that compiles to OCaml"
description:
  "SCaml (Simple Caml) is a functional language with a lightweight, Rust-inspired syntax. Its operators and functions are trait methods, resolved at compile time (modular implicits). SCaml is parsed into OCaml's own AST, type-checked and compiled to a native binary with the OCaml toolchain."
maintainer: ["wer"]
authors: ["wer"]
license: "MIT"
tags: ["language" "compiler" "traits" "modular implicits"]
homepage: "https://github.com/hadriwer/scaml"
doc: "https://github.com/hadriwer/scaml/tree/main/docs"
bug-reports: "https://github.com/hadriwer/scaml/issues"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.5"}
  "menhir" {build}
  "ocamlfind"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/hadriwer/scaml.git"
x-maintenance-intent: ["(latest)"]
